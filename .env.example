# Production activation is fail-closed until the owner records approval.
LIVE_FABRIC_ENABLED=false
LIVE_FABRIC_PRODUCTION_APPROVED=false
LIVE_FABRIC_ALLOWED_ORIGINS=https://www.clearglassinc.com
LIVE_FABRIC_KNOWN_SOURCES=clearglass-configured-monitor
LIVE_FABRIC_PUBLIC_CONNECTIONS_PER_IP=3
LIVE_FABRIC_AUTH_CONNECTIONS_PER_USER=5
LIVE_FABRIC_MAX_EVENT_BYTES=16384
LIVE_FABRIC_HEARTBEAT_MS=15000
LIVE_FABRIC_STREAM_TTL_MS=300000
LIVE_FABRIC_SNAPSHOT_URL=
LIVE_FABRIC_SNAPSHOT_TOKEN=
DATABASE_URL=
REDIS_URL=
OTEL_EXPORTER_OTLP_ENDPOINT=

# Chualar live operations — provider credentials remain server-side only
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
ADSBX_API_KEY=
SATELLITE_API_KEY=

# Agent SDK (clearglassinc_sdk). Provider is fake unless set, so the agent
# smoke mission runs offline with no credential:
#   cd clearglassinc_sdk && PYTHONPATH=. python3 -m clearglassinc_sdk.cli smoke
# Set the provider and its key to run the same mission against a live model.
CLEARGLASS_PROVIDER=
CLEARGLASS_MODEL=
ANTHROPIC_API_KEY=
