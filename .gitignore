# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/
*.egg
.venv/
venv/
env/

# Artemis local runtime state
.artemis/

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*.swo

# Site build output
_site/

# Test artifacts
.pytest_cache/
*.cover
htmlcov/

# JS dependencies
node_modules/

# Stripe catalogue sync output (regenerated on every run; upload as a CI artifact
# instead of committing it)
stripe-sync-report.json

# CircleCI control-plane pipeline output (release manifest + evidence are
# uploaded as CircleCI artifacts, never committed)
artifacts/

# Archives (build artifacts should not be committed)
*.zip
# Exception: intentional static download assets served from /downloads/
!downloads/*.zip

# ── IP PROTECTION: secrets & credentials ────────────────────────────────────
# Never commit API keys, tokens, or credentials.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
secrets/
secret/
credentials/
credentials.json
service-account*.json
*_secret*
*_credentials*
*-credentials*
*-secret*
config/local.*
config/secrets.*

# ── IP PROTECTION: private prompt variants ───────────────────────────────────
# Prompts in /prompts/ are already versioned publicly. Any local drafts or
# unreleased prompt engineering files should be staged here and kept private.
prompts/private/
prompts/draft/
prompts/*.local.md
prompts/*.secret.md

# ── IP PROTECTION: local LLM / model weights ─────────────────────────────────
*.gguf
*.bin
*.safetensors
*.ggml
models/

# ── IP PROTECTION: internal reports & exports ────────────────────────────────
# Bot output may contain client PII or strategic intelligence.
marketing/output/private/
operations/output/private/
reports/
exports/

# ── IP PROTECTION: Terraform state (contains infra secrets) ──────────────────
*.tfstate
*.tfstate.backup
.terraform/
.terraform.lock.hcl

# Priority Matrix bot runtime artifacts (keep example + latest sample)
operations/priority_matrix/archive/
operations/priority_matrix/config.json

# Generated release reports (produced by the OSINT deck release gate)
release/

# Generated by scripts/repo_audit.py (uploaded as CI artifact, never committed)
audit-reports/

# TypeScript incremental build cache (machine-local, never committed)
*.tsbuildinfo

# Next.js build output
.next/
out/

# Cargo build output for the Rust secure-runtime sidecar (one cargo test is
# ~420 MB; .nojekyll would publish anything committed here)
agent_army/secure_runtime/target/

# 4-D Dominance pipeline generated reports
four_d_dominance/output/

# Lighthouse CI run artifacts (generated by `lhci collect`; the search-asset
# generator walks *.html and will otherwise pick these reports up as pages)
.lighthouseci/

# Assurance engagement working copies (real client evidence; never committed).
# The directory itself stays tracked via its .gitkeep.
operations/assurance/engagements/*/

# Named-prospect outreach working files. .nojekyll makes Pages publish every
# tracked file, so a lead list or a personalised draft committed here is served
# on the company domain to the firms it describes. Keep them local; the live
# pipeline belongs in a private sheet (tests/test_no_prospect_files_published.py).
offers/outreach/lead-list-*.csv
!offers/outreach/lead-list-template.csv
offers/outreach/generated/
offers/outreach/drafts-*.md
