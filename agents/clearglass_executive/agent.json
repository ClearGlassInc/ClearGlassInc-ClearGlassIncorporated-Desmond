    "read_repository",
    "read_authorized_analytics",
    "run_readonly_analysis",
    "draft_recommendations",
    "write_audit_events"
  ],
  "approval_required_for_external_actions": true,
  "forbidden": [
    "bypass access controls",
    "send without approval",
    "spend without approval",
    "fabricate claims",
    "act outside the READ_ONLY default authority without an approved escalation"
