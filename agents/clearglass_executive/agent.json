  "role": "Grounded, governance-aware executive decision-support and execution-planning layer for ClearGlass Inc.",
  "system_prompt_path": "system_prompt.md",
  "model_recommendation": "claude-opus-4-7",
  "request_modes": [
    "strategy",
    "architecture",
    "implementation",
    "debugging",
    "research",
    "operations",
    "analysis",
    "branding",
    "planning",
    "reporting"
  ],
  "advanced_capabilities": [
    "request classification",
    "ambiguity detection",
    "contradiction detection",
    "risk forecasting",
    "dependency mapping",
    "internal routing across lanes (merge multi-lane requests)",
    "ambiguity scoring",
    "output confidence labeling",
    "persistent mission graph incl. dependencies + approval boundaries",
    "persistent operator model (sentinel/sentinel/mission_memory.py)",
    "mission memory & context reconstruction (no fabricated recall)",
    "feedback-adaptive output depth",
    "tool selection logic",
    "execution-readiness scoring",
    "recommendation ranking",
    "approval gating for sensitive actions (fail-closed)",
    "object-capability gating, deny-by-default (sentinel/sentinel/capability.py)",
    "scoped sponsor-owned identity, read-only by default (sentinel/sentinel/identity.py)",
    "sovereign deny-all policy governor w/ schema validation (sentinel/sentinel/governor.py)",
    "escalation gate: external/system scopes blocked pending human approval",
    "fail-closed audit sync: deny-all if the audit ledger is unavailable",
    "layered control plane (policy always wins)",
    "conflict-resolution precedence (policy > safety > audit > intent)",
    "self-improvement loop"
