# Agent OS head-agent server. Copy, fill in, and keep the copy out of git.
# Generate each token with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"

# Required. At least 24 characters. Needed for every /api route.
AGENT_OS_API_TOKEN=

# Optional, but without it every approval is refused, so gated tasks wait forever.
# Must differ from AGENT_OS_API_TOKEN: the token that submits work cannot approve it.
AGENT_OS_APPROVER_TOKEN=

# Task database. Default: .agent_os/tasks.sqlite3 in the repository root.
AGENT_OS_DB=

# Defaults: 127.0.0.1, 8765. Bind wider only with TLS in front of it.
AGENT_OS_BIND=127.0.0.1
AGENT_OS_PORT=8765

# Worker threads (1-4), and the seconds running commands get on SIGTERM.
AGENT_OS_WORKERS=1
AGENT_OS_SHUTDOWN_GRACE=30
