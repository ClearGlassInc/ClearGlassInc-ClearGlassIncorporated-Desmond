{
  "platform": "ClearGlass Intelligence Platform",
  "version": "1.0.0",
  "status": "brand-architecture",
  "status_note": "Canonical naming and brand architecture registry. Entries describe the target platform taxonomy; a registry entry does not mean the system is provisioned. Provisioned systems are documented in their own subtrees (sentinel/, clearglass-commerce/, apps/).",
  "naming_standard": {
    "description": "Every named thing in the ClearGlass ecosystem resolves to exactly one tier. Tier prefixes are reserved; instance identifiers follow the tier pattern.",
    "tiers": [
      {
        "tier": "platform",
        "prefix": "ClearGlass",
        "pattern": "^ClearGlass [A-Z][A-Za-z]+$",
        "example": "ClearGlass Nexus"
      },
      {
        "tier": "ai_engine",
        "prefix": "Cortex",
        "pattern": "^Cortex-[0-9]+$",
        "example": "Cortex-1"
      },
      {
        "tier": "agent",
        "prefix": "CGA",
        "pattern": "^CGA-[A-Z][A-Za-z]+-[0-9]{2}$",
        "example": "CGA-Sentinel-01"
      },
      {
        "tier": "workflow",
        "prefix": "Flow",
        "pattern": "^Flow-[A-Z][A-Za-z]+-[0-9]{3}$",
        "example": "Flow-Incident-001"
      },
      {
        "tier": "knowledge",
        "prefix": "Chronicle",
        "pattern": "^Chronicle-[A-Z][A-Za-z]+$",
        "example": "Chronicle-Alpha"
      },
      {
        "tier": "security",
        "prefix": "Sentinel",
        "pattern": "^Sentinel-[A-Z][A-Za-z]+$",
        "example": "Sentinel-Edge"
      },
      {
        "tier": "analytics",
        "prefix": "Vector",
        "pattern": "^Vector-[A-Z][A-Za-z0-9]*$",
        "example": "Vector-X"
      },
      {
        "tier": "automation",
        "prefix": "Forge",
        "pattern": "^Forge-[A-Z][A-Za-z]+$",
        "example": "Forge-Auto"
      },
      {
        "tier": "infrastructure",
        "prefix": "Bastion",
        "pattern": "^Bastion-[A-Z][A-Za-z]+$",
        "example": "Bastion-Cloud"
      },
      {
        "tier": "executive",
        "prefix": "Oracle",
        "pattern": "^Oracle-[A-Z][A-Za-z]+$",
        "example": "Oracle-Prime"
      }
    ]
  },
