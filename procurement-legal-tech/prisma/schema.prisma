generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }
enum Role { OWNER ADMIN MEMBER BILLING_MANAGER }
enum Plan { CONTROL OVERSIGHT COMMAND }
enum SubscriptionStatus { TRIALING ACTIVE PAST_DUE CANCELED INCOMPLETE }
model User { id String @id @default(cuid()) externalAuthId String @unique email String @unique memberships Membership[] createdAt DateTime @default(now()) }
model Workspace { id String @id @default(cuid()) name String plan Plan @default(CONTROL) trialEndsAt DateTime memberships Membership[] vendors Vendor[] agreements Agreement[] approvals Approval[] auditEvents AuditEvent[] subscription Subscription? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model Membership { id String @id @default(cuid()) role Role workspaceId String userId String workspace Workspace @relation(fields:[workspaceId],references:[id],onDelete:Cascade) user User @relation(fields:[userId],references:[id],onDelete:Cascade) @@unique([workspaceId,userId]) }
model Vendor { id String @id @default(cuid()) workspaceId String name String ownerId String? monthlyCostCents Int? renewalAt DateTime? workspace Workspace @relation(fields:[workspaceId],references:[id],onDelete:Cascade) agreements Agreement[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt @@index([workspaceId,renewalAt]) }
model Agreement { id String @id @default(cuid()) workspaceId String vendorId String? title String ownerId String? renewalAt DateTime? noticeDays Int? objectKey String? mimeType String? byteSize Int? scanStatus String @default("PENDING") workspace Workspace @relation(fields:[workspaceId],references:[id],onDelete:Cascade) vendor Vendor? @relation(fields:[vendorId],references:[id],onDelete:SetNull) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt @@index([workspaceId,renewalAt]) }
model Approval { id String @id @default(cuid()) workspaceId String kind String requestedById String status String @default("PENDING") decidedById String? decidedAt DateTime? payload Json workspace Workspace @relation(fields:[workspaceId],references:[id],onDelete:Cascade) createdAt DateTime @default(now()) @@index([workspaceId,status]) }
model Subscription { id String @id @default(cuid()) workspaceId String @unique stripeCustomerId String @unique stripeSubscriptionId String? @unique status SubscriptionStatus plan Plan interval String currentPeriodEnd DateTime? cancelAtPeriodEnd Boolean @default(false) workspace Workspace @relation(fields:[workspaceId],references:[id],onDelete:Cascade) updatedAt DateTime @updatedAt }
model StripeEvent { id String @id eventType String payloadHash String processedAt DateTime @default(now()) }
model AuditEvent { id String @id @default(cuid()) workspaceId String actorId String? action String targetType String targetId String? metadata Json? previousHash String? eventHash String @unique workspace Workspace @relation(fields:[workspaceId],references:[id],onDelete:Restrict) createdAt DateTime @default(now()) @@index([workspaceId,createdAt]) }
model MarketingConsent { id String @id @default(cuid()) userId String channel String status String source String policyVersion String consentedAt DateTime? withdrawnAt DateTime? @@unique([userId,channel]) }
