# ClearGlass RFED(TM) — required runtime configuration.
# Copy to the n8n instance's environment. Never commit real values.

# --- ingress (zero-trust) ---------------------------------------------------
# HMAC-SHA256 shared secret for the /rfed/propose webhook. Unset = the workflow
# refuses every proposal. Rotate quarterly; rotation is itself a gated action.
RFED_WEBHOOK_SECRET=

# --- model ------------------------------------------------------------------
ANTHROPIC_API_KEY=
# Exact model id, recorded verbatim on every ledger row. Never a marketing name —
# the ledger has to say which model actually decided.
RFED_MODEL_ID=claude-opus-5

# --- ledger -----------------------------------------------------------------
# Postgres/Supabase connection used by the three postgres nodes. The role must
# have INSERT + SELECT on rfed_records and NO update/delete grant: the triggers
# are the second line of defence, not the first.
RFED_PG_HOST=
RFED_PG_PORT=5432
RFED_PG_DATABASE=
RFED_PG_USER=rfed_writer
RFED_PG_PASSWORD=

# --- execution --------------------------------------------------------------
# Executor endpoint for auto-approved low-risk actions. It MUST re-verify the
# x-rfed-record / x-rfed-chain headers against the ledger before acting.
RFED_EXECUTOR_URL=
RFED_EXECUTOR_TOKEN=
# Defaults to dry-run. Only set to the literal string "false" after the client
# has signed off on a review window of drafted actions.
RFED_DRY_RUN=true

# --- human approval ---------------------------------------------------------
SLACK_APPROVAL_WEBHOOK=
SLACK_SECURITY_WEBHOOK=
# Verifies inbound Slack button callbacks in the companion approval workflow.
SLACK_SIGNING_SECRET=

# --- n8n instance requirements ---------------------------------------------
# The Code nodes require node's crypto module for HMAC + SHA-256.
NODE_FUNCTION_ALLOW_BUILTIN=crypto
# Ledger integrity depends on serialised appends. Keep concurrency at 1 for this
# workflow, or the chain-guard trigger will (correctly) reject racing inserts.
N8N_CONCURRENCY_PRODUCTION_LIMIT=1
