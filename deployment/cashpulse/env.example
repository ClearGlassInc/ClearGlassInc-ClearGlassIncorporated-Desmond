# CashPulse — copy to .env (never commit) and fill in per client.

# --- Mode ---
DRY_RUN=true                      # flip to false after 72h shadow run
CLIENT_SLUG=acme-co

# --- Anthropic ---
ANTHROPIC_API_KEY=
CLAUDE_DRAFTING_MODEL=claude-haiku-4-5-20251001
CLAUDE_TRIAGE_MODEL=claude-sonnet-4-6

# --- Email / SMS ---
GMAIL_OAUTH_CRED_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Calendar ---
GCAL_CRED_ID=
BOOKING_LINK=https://cal.com/your-handle/intro

# --- Invoicing ---
STRIPE_API_KEY=
QBO_OAUTH_CRED_ID=

# --- Banking (read-only) ---
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ACCESS_TOKEN=

# --- Audit ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- Approvals ---
SLACK_WEBHOOK_URL=
SLACK_APPROVALS_CHANNEL=#cashpulse-approvals
OWNER_SLACK_USER_ID=

# --- Guardrails ---
MAX_EMAILS_PER_LEAD_PER_WEEK=3
A_TIER_DEAL_ALERT_THRESHOLD_USD=10000
