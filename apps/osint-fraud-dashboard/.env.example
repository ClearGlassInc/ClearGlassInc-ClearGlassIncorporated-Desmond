# Copy to .env and fill in. Never commit .env.

# PostgreSQL connection used by the app, Prisma migrations and the seed.
# For docker compose the app container builds its own URL; this one is for running on the host.
DATABASE_URL=postgresql://cg_osint:cg_osint_local@127.0.0.1:5434/cg_osint

# Integration tests reset this database. Its name must end in _test.
TEST_DATABASE_URL=postgresql://cg_osint:cg_osint_local@127.0.0.1:5434/cg_osint_test

# local | test | production. Unset means production, which refuses demo sign-in.
APP_ENV=local

# Demo sign-in: local development only. Refused when APP_ENV is production.
DEMO_AUTH_ENABLED=true

# HMAC key for demo session cookies, 32+ characters. Generate one, for example:
#   openssl rand -hex 32
SESSION_SECRET=

# Optional: docker compose database password (default cg_osint_local, local only).
# POSTGRES_PASSWORD=

# Import limits (defaults shown).
# IMPORT_MAX_BYTES=524288
# IMPORT_MAX_ROWS=5000

# Hosts a future live OSINT adapter may fetch from, comma separated. Empty
# means every server-side fetch is refused. No shipped adapter fetches.
OSINT_FETCH_ALLOWLIST=
