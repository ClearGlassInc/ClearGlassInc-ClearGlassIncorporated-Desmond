{
  "name": "@clearglass/osint-fraud-dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "ClearGlass OSINT Fraud Detection Dashboard - local prototype on synthetic fixtures",
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3050",
    "build": "next build",
    "start": "next start -H 127.0.0.1 -p 3050",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:all": "vitest run",
    "audit:deps": "npm audit --omit=dev"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "next": "16.4.0",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dotenv": "18.0.6",
    "prisma": "7.10.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  },
  "overrides": {
    "mysql2": "3.24.5",
    "deepmerge-ts": "8.0.2"
  }
}
