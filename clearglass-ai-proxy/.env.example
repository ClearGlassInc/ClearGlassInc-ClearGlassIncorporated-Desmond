# ClearGlass AI Gateway - example environment.
#
# PLACEHOLDERS ONLY. Never commit a real value; .env is gitignored.
#
# In production these are NOT read from a file. Secrets live in Cloudflare
# Worker secrets and GitHub Actions secrets; non-secret settings live in
# [vars] in wrangler.toml. This file documents the full surface and is used
# with `wrangler dev` for local development (see README).

# =========================================================================
# SECRETS - set with `npx wrangler secret put <NAME>`, never in wrangler.toml
# =========================================================================

# Credential for the upstream AI provider. Never exposed to browsers, never
# logged, never returned in an error body.
OPENAI_API_KEY=sk-REPLACE_ME

# Credential your own clients present as `Authorization: Bearer <token>`.
# Minimum 24 characters - the gateway refuses to start below that, because a
# short token is functionally an open proxy.
# Generate one:  openssl rand -hex 32
# Comma-separate two values to rotate with no downtime.
PROXY_ACCESS_TOKEN=REPLACE_ME_WITH_A_32_BYTE_RANDOM_HEX_STRING

# =========================================================================
# NON-SECRET CONFIGURATION - mirrors [vars] in wrangler.toml
# =========================================================================

PROVIDER=openai
OPENAI_BASE_URL=https://api.openai.com/v1
DEFAULT_MODEL=gpt-5-mini

# Comma-separated. Unset means only DEFAULT_MODEL is reachable.
ALLOWED_MODELS=gpt-5-mini

# Leave empty to keep /v1/embeddings disabled.
ALLOWED_EMBEDDING_MODELS=

# Exact browser origins, comma-separated. "*" for local development only.
ALLOWED_ORIGIN=

RATE_LIMIT_PER_MINUTE=30
MAX_REQUEST_BYTES=32768
MAX_OUTPUT_TOKENS=2048
MAX_OUTPUT_TOKENS_FIELD=max_completion_tokens
MAX_MESSAGES=64
MAX_COMPLETIONS=4
UPSTREAM_TIMEOUT_MS=30000
ALLOW_STREAMING=true
