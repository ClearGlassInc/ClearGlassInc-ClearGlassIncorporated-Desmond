# Commerce control plane — environment variable NAMES ONLY.
#
# Never commit values. Every secret below is a runtime environment variable set
# in the hosting platform's secret manager (Render environment groups, or the
# equivalent), not in this file and not in source control.
#
# Unset credentials are safe: each integration runs in mock mode with no
# credentials, makes no network call, and moves no money. The one exception is
# ADMIN_API_KEY, which the app refuses to start without when APP_ENV=production.
#
# Copy to .env for local development. .env is gitignored.

# ── Application ────────────────────────────────────────────────────────────
APP_ENV=development
APP_NAME=clearglass-commerce
LOG_LEVEL=info
DATABASE_URL=
AUTO_CREATE_TABLES=false
# Apply pending migrations/*.sql at startup (Postgres only, seeds excluded).
# Needed on any database that outlives a release: AUTO_CREATE_TABLES adds new
# tables but never new columns. Manual: python -m app.migrate [--status|--check]
RUN_MIGRATIONS=false
CORS_ALLOW_ORIGINS=

# ── Admin authentication ───────────────────────────────────────────────────
# Comma-separated to allow rotation. Unset = open dev/mock mode; unset with
# APP_ENV=production = the app fails closed at startup, by design.
ADMIN_API_KEY=

# ── Governance ─────────────────────────────────────────────────────────────
REQUIRE_APPROVAL_FOR_HIGH_RISK=true
INVENTORY_LOW_THRESHOLD=

# ── Rate limiting ──────────────────────────────────────────────────────────
RATE_LIMIT_CHECKOUT_PER_MINUTE=
RATE_LIMIT_WEBHOOK_PER_MINUTE=
RATE_LIMIT_DECISIONS_PER_MINUTE=
# Behind a reverse proxy (Render, Cloudflare) set BOTH, or every caller shares
# one throttle bucket and one abusive client can 429 the whole storefront.
TRUSTED_PROXY_HOPS=
TRUSTED_PROXY_IPS=

# ── Stripe ─────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
STRIPE_AUTOMATIC_TAX=
CHECKOUT_SUCCESS_URL=
CHECKOUT_CANCEL_URL=
STRIPE_PORTAL_RETURN_URL=

# ── PayPal (Orders v2) ─────────────────────────────────────────────────────
# PAYPAL_WEBHOOK_ID is not optional in practice: without it no PayPal webhook
# can be verified, so every notification is refused and no PayPal payment is
# ever booked. See docs/REVENUE_OPERATIONS.md.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Defaults to the sandbox. Point at https://api-m.paypal.com only after the
# sandbox end-to-end test in docs/REVENUE_OPERATIONS.md has passed.
PAYPAL_API_BASE=
PAYPAL_RETURN_URL=
PAYPAL_CANCEL_URL=
PAYPAL_COLLECT_SHIPPING=

# ── Payout visibility (masked metadata only — never raw bank details) ──────
PAYOUT_EXTERNAL_ACCOUNT_ID=
PAYOUT_BANK_NAME=
PAYOUT_BANK_LAST4=
PAYOUT_BANK_ROUTING_HINT=
PAYOUT_BANK_COUNTRY=
PAYOUT_BANK_CURRENCIES=

# ── Etsy Open API v3 ───────────────────────────────────────────────────────
# Obtained through the OAuth2 (PKCE) flow: `python -m app.etsy_connect`.
# See ETSY_CONNECT.md. Every Etsy write is human-gated regardless of scope.
ETSY_KEYSTRING=
ETSY_SHARED_SECRET=
ETSY_ACCESS_TOKEN=
ETSY_REFRESH_TOKEN=
ETSY_SHOP_ID=
ETSY_SHOP_NAME=
ETSY_SCOPES=
ETSY_REDIRECT_URI=

# ── Printful (print-on-demand fulfillment) ─────────────────────────────────
PRINTFUL_API_KEY=
PRINTFUL_STORE_ID=
PRINTFUL_WEBHOOK_SECRET=
# Records intent only. Order confirmation is an always-escalate action and this
# flag does not open that gate.
PRINTFUL_AUTO_CONFIRM=false

# ── Alerting ───────────────────────────────────────────────────────────────
ESCALATION_EMAIL=
# Slack incoming webhook for the revenue channel (app/revenue_notify.py). Posts one
# message per revenue step, only after it commits; no names or emails. Must start
# with https://hooks.slack.com/ or it is ignored. The URL is a credential: keep it
# in the platform secret store. Empty = off.
SLACK_WEBHOOK_URL=

# ── ClearGlass Revenue Command System ─────────────────────────────────────
# Safe production defaults keep live sale activation blocked until owner approval.
CRCS_FIRST_OFFER_SKU=rapid-website-deployment-diagnostic
CRCS_RAPID_DIAGNOSTIC_ENABLED=false
# Hosted Stripe Payment Link, if approved. Empty = no live payment-link CTA.
CRCS_RAPID_DIAGNOSTIC_PAYMENT_LINK=
# Optional calendar booking URL. Empty = manual booking fallback.
CRCS_CALENDAR_BOOKING_URL=
# HMAC key for the buyer reference the audit ledger stores instead of an email
# address. Set a long random value in production and keep it stable: rotating it
# breaks correlation with earlier ledger rows, nothing else.
CRCS_AUDIT_HASH_KEY=
# NOT READ BY ANY CODE. A static page cannot see server env vars:
# revenue-command.html takes its API base from its own
# <meta name="cg-revenue-api" content="https://..."> tag, which ships empty, so
# on GitHub Pages the lead form posts to the static host and records nothing.
# Set that meta tag to this control plane's verified public URL.
CRCS_PUBLIC_API_BASE_URL=
REVENUE_LEAD_RATE_LIMIT_PER_MINUTE=30
# NOT READ BY ANY CODE. Reserved; setting it has no effect.
REVENUE_ADMIN_EXPORT_LIMIT=

# ── Sentinel Core answered by Claude (app/sentinel_ai.py, POST /sentinel/ask) ──
# Off by default. Needs SENTINEL_AI_ENABLED=true AND ANTHROPIC_API_KEY. The key is
# read by the Anthropic SDK from the environment only; never put it in the site.
# The public console stays rule-guided until station-chat.js's SITE.api (or a
# page's <meta name="cg-sentinel-api">) names this service's public URL.
SENTINEL_AI_ENABLED=false
ANTHROPIC_API_KEY=
SENTINEL_MODEL=claude-opus-5
SENTINEL_EFFORT=medium
SENTINEL_MAX_TOKENS=16000
SENTINEL_MAX_TOOL_ROUNDS=4
# Hard cap on model calls per UTC day across all visitors. 0 refuses every call.
SENTINEL_DAILY_REQUEST_CAP=500
RATE_LIMIT_SENTINEL_PER_MINUTE=10
SENTINEL_SITE_INDEX_URL=https://www.clearglassinc.com/data/site-index.json
# A local copy (repo checkout) wins over the URL. Empty = fetch the URL.
SENTINEL_SITE_INDEX_PATH=
SENTINEL_INDEX_TTL_SECONDS=600
# HMAC key for the question fingerprint in the audit ledger. Set a long random value.
SENTINEL_AUDIT_HASH_KEY=
